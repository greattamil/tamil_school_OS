<?xml version="1.0" encoding="utf-8"?>
<!--
  LOCAL DEVELOPMENT ONLY. Android blocks plaintext (non-HTTPS) traffic by
  default for apps targeting a modern API level, for every build type, not
  just release. This app's real backend must be served over TLS 1.3 per PRD
  6.4 ("TLS 1.3 for all traffic, certificates managed automatically";
  the Caddy reverse proxy in the deployment stack, PRD 8.1, is what
  terminates this in production); this file exists only so a local build
  can reach a Docker Compose backend on plain HTTP during development.

  Scoped to exactly the hosts a local dev backend is reached on:
  - 10.0.2.2 is the standard Android-emulator alias for the host machine.
  - localhost/127.0.0.1 for a device/emulator hitting a backend on itself.

  Before any build leaves this machine (a real device, a shared build, a
  release intended for actual distribution), point API_BASE_URL at a real
  HTTPS backend and delete this file and its reference in
  AndroidManifest.xml. Do not widen this exception instead.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
