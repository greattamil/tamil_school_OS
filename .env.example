# Copy to .env and fill in local values. Never commit the real .env file.

# Superuser password for the postgres role (used only by migrations).
POSTGRES_PASSWORD=change_me_postgres

# Password for the non-owner, non-superuser app_user role the API connects as.
# Created by deploy/postgres-init/01-app-role.sh on first container init.
APP_DB_PASSWORD=change_me_app_user

# HMAC secret used to sign access tokens. Generate with:
#   openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_value
